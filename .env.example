# Asterisk ARI
ARI_BASE_URL=http://localhost:8088
ARI_USERNAME=voip-agent
# REQUIRED: a strong secret matching asterisk/ari.conf. The agent refuses to
# start if this is unset or left as "changeme".
ARI_PASSWORD=
ARI_APP_NAME=voip-agent

# RTP — agent binds here to receive ExternalMedia audio
RTP_BIND_HOST=0.0.0.0
# Address Asterisk sends RTP *to* (ExternalMedia destination). Must be
# reachable from Asterisk and never 0.0.0.0. Default 127.0.0.1 assumes the
# agent is co-located with Asterisk; set the agent host's LAN IP otherwise.
RTP_ADVERTISE_HOST=127.0.0.1
RTP_PORT=5000

# DGX Spark AI services
STT_BASE_URL=http://dgx-spark:8001
TTS_BASE_URL=http://dgx-spark:8002
LLM_BASE_URL=http://dgx-spark:8000
LLM_MODEL=nous-hermes
EMBEDDING_BASE_URL=http://dgx-spark:8003

# Turn detection (Smart Turn v2). Off by default (fail-closed); verify German live first.
TURN_DETECTION_ENABLED=false
TURN_DETECTOR_URL=http://dgx-spark:8004
TURN_COMPLETE_THRESHOLD=0.5
TURN_CLASSIFY_TIMEOUT_MS=150
TURN_VAD_SILENCE_MS=200

# pgvector RAG
DB_DSN=postgresql://user:pass@dgx-spark:5432/voip

# MS Graph Calendar
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
CALENDAR_USER_EMAIL=

# Tool / LLM safety
# Calendar writes are disabled by default (fail closed) so a caller cannot
# create events. Set true to allow it; even then the model must pass
# confirmed=true after the caller verbally agrees.
CALENDAR_WRITE_ENABLED=false
MAX_TOOL_ROUNDS=5
# Comma-separated caller numbers allowed to use tools (RAG + calendar reads
# and writes). Empty = no caller authorized = tools off for everyone (fail
# closed). Unknown callers can still converse, just without data access.
TRUSTED_CALLERS=

# Agent behaviour
CALLER_ID=+49123456789
GREETING_TEXT=Hallo, wie kann ich Ihnen helfen?
LLM_SYSTEM_PROMPT=Du bist ein hilfreicher Telefonassistent. Antworte immer auf Deutsch. Sei freundlich und präzise. Nutze rag_lookup für Wissensfragen und die Kalender-Werkzeuge für Terminanfragen.
