# Direct FRITZ!Box PJSIP transport (no Asterisk)
FRITZBOX_HOST=192.168.178.1
FRITZBOX_SIP_USERNAME=
FRITZBOX_SIP_PASSWORD=
PJSIP_TRANSPORT=udp
PJSIP_LOCAL_PORT=5062
# Level 2 suppresses SIP/media detail that may contain caller numbers.
PJSIP_LOG_LEVEL=2
PJSIP_EVENT_POLL_MS=10
ANSWER_DELAY_SECONDS=20
MAX_CALL_SECONDS=900
MAX_CONCURRENT_CALLS=1

# DGX Spark AI services
DGX_HOST_IP=192.168.68.41
STT_BASE_URL=https://mate.olcon.de
TTS_BASE_URL=https://mate.olcon.de
LLM_BASE_URL=https://mate.olcon.de
LLM_MODEL=companion-gemma
EMBEDDING_BASE_URL=http://dgx-spark:8003
AI_PROXY_USERNAME=voip-agent
AI_PROXY_PASSWORD_FILE=/run/secrets/shared_ai_password
AI_PROXY_CA_FILE=/run/secrets/mate_ca.crt
VOICE_PRIORITY_TOKEN_FILE=/run/secrets/voice_priority_token
VOICE_PRIORITY_BASE_URL=https://mate.olcon.de

# Turn detection (Smart Turn v3, in-process ONNX). On by default; set false for the legacy 800ms path.
TURN_DETECTION_ENABLED=true
TURN_COMPLETE_THRESHOLD=0.70
TURN_VAD_SILENCE_MS=200
TURN_MODEL_REPO=pipecat-ai/smart-turn-v3
TURN_MODEL_FILENAME=smart-turn-v3.2-cpu.onnx
TURN_MODEL_REVISION=f766f81d3cfdf7737ac64aad813d91bbfd56bf93
TURN_ONNX_PROVIDERS=CPUExecutionProvider

# pgvector RAG
DB_DSN=postgresql://user:pass@dgx-spark:5432/voip

# MS Graph Calendar
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
CALENDAR_USER_EMAIL=

# Tool / LLM safety
# Calendar writes are disabled by default (fail closed) so a caller cannot
# create events. Set true to allow it; even then the model must pass
# confirmed=true after the caller verbally agrees.
CALENDAR_WRITE_ENABLED=false
MAX_TOOL_ROUNDS=5
# Comma-separated caller numbers allowed to use tools (RAG + calendar reads
# and writes). Empty = no caller authorized = tools off for everyone (fail
# closed). Unknown callers can still converse, just without data access.
TRUSTED_CALLERS=

# Agent behaviour
CALLER_ID=+49123456789
GREETING_TEXT=Hallo, wie kann ich Ihnen helfen?
LLM_SYSTEM_PROMPT=Du bist ein hilfreicher Telefonassistent. Antworte immer auf Deutsch. Sei freundlich und präzise. Nutze rag_lookup für Wissensfragen und die Kalender-Werkzeuge für Terminanfragen.
