ASR_MODEL=Qwen/Qwen3-ASR-1.7B
TTS_MODEL=qwen3-tts

# Interface the inference container ports bind to on the DGX host.
# Default (unset) is 0.0.0.0 = all interfaces. Set to the DGX LAN IP so the
# ports are reachable by the agent host but not the WAN, and firewall to the
# agent. Use 127.0.0.1 only if the agent runs on the DGX itself.
# DGX_BIND_IP=192.168.178.3

# Limit which GPUs the containers can see (blast radius). Default "all".
# NVIDIA_VISIBLE_DEVICES=0

# Embedding model served by the embedding container.
# EMBEDDING_MODEL=intfloat/multilingual-e5-large
