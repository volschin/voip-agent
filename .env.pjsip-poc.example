# Scope: the signalling-only proof of concept (compose.pjsip-poc.yml,
# `python -m agent.pjsip_poc`). Production uses .env only — do not wire this
# file into compose.yml.

# FRITZ!Box 7690 LAN address or resolvable hostname.
FRITZBOX_HOST=192.168.178.1

# Credentials created for the dedicated LAN/WLAN IP telephone in the
# FRITZ!Box UI. The username is not necessarily its internal 620-629 number.
FRITZBOX_SIP_USERNAME=ai-answering-machine
FRITZBOX_SIP_PASSWORD=

# UDP is the initial FRITZ!Box PoC transport. The local port must be unused on
# the Docker host because the container deliberately uses host networking.
PJSIP_TRANSPORT=udp
PJSIP_LOCAL_PORT=5062

# Roughly four rings; calibrate against the actual handsets.
ANSWER_DELAY_SECONDS=20

# The signalling-only PoC is silent after answering and therefore hangs up
# automatically. Production uses MAX_CALL_SECONDS in .env instead; this key is
# read by agent.pjsip_poc only.
POC_MAX_CALL_SECONDS=30
MAX_CONCURRENT_CALLS=1

# Use 4 only temporarily for complete SIP message diagnostics.
PJSIP_LOG_LEVEL=3
PJSIP_EVENT_POLL_MS=50
LOG_LEVEL=INFO
